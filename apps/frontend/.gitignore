# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# vite
/dist/
/out/

# tanstack router generator scratch space. `@tanstack/router-plugin` writes
# temp files here on every dev/build/test run; they are not inputs. The
# directory is mostly empty, which is why this was invisible until a test run
# left a file behind and `git status` showed an untracked `.tanstack/`.
/.tanstack/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
