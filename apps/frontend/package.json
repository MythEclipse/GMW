{
  "name": "frontend",
  "version": "0.1.0",
  "description": "Bete GMW frontend — React 19 + Vite SPA for Discord moderation monitoring",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
