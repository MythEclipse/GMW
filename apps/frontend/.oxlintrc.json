{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "@shadcn/lint"
  ],
  "ignorePatterns": [
    "dist/**",
    "out/**",
    "build/**"
  ],
  "settings": {
    "shadcn": {
      "ui": "#/components/ui"
    }
  },
  "rules": {
    "shadcn/no-raw-colors": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": [
          "layout"
        ],
        "contracts": [
          {
            "pattern": "^Card$",
            "allow": [
              "layout",
              "channel-row",
              "channel-roster-card",
              "glass",
              "glossary-entry",
              "hud-card",
              "linear-tile",
              "mod-tile",
              "msg-feed-card",
              "stagger-item",
              "user-tile"
            ]
          },
          {
            "pattern": "^TabsList$",
            "allow": [
              "layout",
              "tabs-touch"
            ]
          }
        ]
      }
    ],
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "layout",
          "transition-[width]",
          "transition-[grid-template-rows]"
        ]
      }
    ],
    "shadcn/require-static-classes": "error",
    "shadcn/no-unknown-classes": "warn"
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ]
}
