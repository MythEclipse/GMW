{
  "name": "discord-moderation-backend",
  "version": "1.0.0",
  "description": "GMW \u2014 Discord moderation backend: HTTP/oRPC dashboard, Discord capture, and the moderation worker in one process",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc && node scripts/fix-imports.mjs",
    "dev": "tsx watch src/index.ts",
    "format": "biome format --write .",
    "lint": "biome check --diagnostic-level=error .",
    "start": "node dist/index.js",
    "test": "bun test tests/ tests-gateway/",
    "typecheck": "tsc --noEmit",
    "test:e2e": "bun test src/e2e.test.ts"
  },
  "dependencies": {
    "@gmw/db": "workspace:*",
    "@orpc/server": "1.15.4",
    "@prisma/adapter-pg": "7.10.0",
    "@vectorize-io/hindsight-client": "0.10.2",
    "axios": "^1.20.0",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "openai": "^7.25.0",
    "opusscript": "^0.1.1",
    "p-limit": "^7.3.3",
    "p-retry": "^8.0.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "piscina": "^5.3.2",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "tiktoken": "^1.0.22",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
