{
  "name": "@bete/discord-gateway",
  "version": "1.0.0",
  "description": "Discord Gateway service - handles message capture and AI moderation",
  "type": "module",
  "main": "dist/index.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && node scripts/fix-imports.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --diagnostic-level=error .",
    "format": "biome format --write .",
    "test": "bun test tests/",
    "test:e2e": "bun test tests/llmE2e.test.ts"
  },
  "dependencies": {
    "@vectorize-io/hindsight-client": "0.10.2",
    "axios": "^1.20.0",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "openai": "^7.25.0",
    "opusscript": "^0.1.1",
    "p-limit": "^7.3.3",
    "p-retry": "^8.0.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "piscina": "^5.3.2",
    "sharp": "^0.35.5",
    "tiktoken": "^1.0.22",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "@types/bun": "latest"
  },
  "packageManager": "bun@1.4.2"
}