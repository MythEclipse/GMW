# Discord Bot Configuration
# =============================================================================
#
# PRODUCTION ENV IS DECLARATIVE:
# The runtime env file on the VPS (/etc/gmw/gmw.env) is WRITTEN BY CI from
# Gitea Actions secrets (BACKEND_ENV) — see .gitea/workflows/deploy.yml.
# To change production env: update the secret in Gitea repo settings
# (Settings → Actions → Secrets), then push any commit to main. Never
# SSH into the VPS to edit env files by hand — CI will overwrite them.
#
# This file documents every variable; values for production live in the
# secrets, not here.

# === Discord ===
DISCORD_TOKEN=your_bot_token_here       # REQUIRED
MONITOR_GUILD_ID=your_guild_id_here     # Target guild for text monitoring
TEXT_GUILD_ID=optional_text_guild_id    # Override text capture guild (falls back to MONITOR_GUILD_ID)
TEXT_CHANNEL_ID=optional_text_channel_id # Restrict text capture to a single channel
# Excluded from capture entirely — never stored, never on the dashboard.
EXCLUDED_CHANNEL_IDS=                   # Comma-separated channel IDs
EXCLUDED_THREAD_IDS=                    # Comma-separated thread IDs
# Bot messages are never captured in these channels. Bot detection stays ON
# everywhere else.
BOT_EXCLUDED_CHANNEL_IDS=1206269771340058694,1318544753821880362
# Still CAPTURED and still on the dashboard, but never AI-analyzed: the message
# lands in the terminal `skipped` state, is never re-claimed, and gets no
# verdict. Use this for channels deliberately outside moderation (e.g. a
# bot-dedicated channel). Use EXCLUDED_CHANNEL_IDS when the channel should be
# invisible to the dashboard too. A thread inherits its parent's id, so listing
# a channel also exempts every thread under it. Entries are trimmed.
AI_SKIP_ANALYSIS_CHANNEL_IDS=1308392257975488593,1508059937031589949
# Same terminal `skipped` treatment, but for individual threads. The channel
# list above cannot express this: a thread's messages store the PARENT id in
# channel_id, so a thread id listed there matches nothing. Entries are trimmed.
AI_SKIP_ANALYSIS_THREAD_IDS=
# How many messages BEFORE the one being judged are included in the prompt, per
# analysed message (0-50, default 10). Scoped to the same thread — a thread
# inherits its parent's channel id, so this deliberately does NOT widen to the
# whole channel. Without it, a reply like "balasan itu" is judged with no way to
# see what "itu" was. 0 removes the block entirely; it is not a quality dial.
AI_MODERATION_CONTEXT_WINDOW=10
# Never AI-analyzed (captured but skipped), by user id — for high-volume
# music/reaction bots whose embeds carry no moderation signal.
AI_SKIP_ANALYSIS_USER_IDS=411916947773587456

# === Logging ===
# Read directly from the environment by the logger, not by the config schema:
# the logger is what reports a bad config, so it cannot depend on the config
# module loading successfully.
LOG_LEVEL=info                          # Pino log level: error|warn|info|http|verbose|debug|silly (default: info)
NODE_ENV=development                    # development enables pino-pretty (default: development)
VERBOSE=false                           # Log every discord.js debug line, not just errors/streams (default: false)

# === Database (PostgreSQL) ===
# Option 1: Connection string (overrides individual params)
DATABASE_URL=postgresql://asephs:***@100.121.180.82:6432/dcbot

# Option 2: Individual connection parameters
POSTGRES_HOST=localhost                 # PostgreSQL host (default: localhost)
POSTGRES_PORT=5432                      # PostgreSQL port (default: 5432)
POSTGRES_USER=postgres                  # PostgreSQL user (optional if DATABASE_URL provided)
POSTGRES_PASSWORD=your_password_here    # PostgreSQL password (optional if DATABASE_URL provided)
POSTGRES_DB=discord_bot                 # PostgreSQL database name (optional if DATABASE_URL provided)
POSTGRES_POOL_MIN=2                     # Minimum pool connections (default: 2)
POSTGRES_POOL_MAX=10                    # Maximum pool connections (default: 10)

# === Redis ===
REDIS_URL=redis://100.121.180.82:6379        # Redis connection string (default: redis://localhost:6379)

# === Attachments ===
TELE_UPLOAD_URL=https://upload.asepharyana.my.id/api/upload   # Attachment upload endpoint (default)
ATTACHMENT_UPLOAD_TIMEOUT_MS=30000      # Upload timeout in ms (default: 30000)
ATTACHMENT_MAX_SIZE_MB=100              # Max attachment size in MB (default: 100)
ATTACHMENT_RETRY_ATTEMPTS=3             # Upload retry count (default: 3)

# === AI Analysis ===
# Moderation always runs. There is no on/off switch: a misconfigured or
# half-applied env cannot leave the queue silently unmoderated, which is
# indistinguishable from "nothing was violating".
AI_LLM_API_KEY=                        # REQUIRED. LLM API key
AI_LLM_BASE_URL=http://100.121.180.82:20128/api/v1  # LLM API base URL (omniroute — OpenAI-compatible router on imrnes, Tailscale 100.121.180.82)
AI_LLM_MODEL=text                       # LLM text model name (default: text)
# AI_LLM_VISION_MODEL=                   # Vision model for image analysis (falls back to AI_LLM_MODEL)

# === AI Analysis Tuning ===
# Messages claimed per moderation call. Larger batches are cheaper per message
# but risk a timeout that loses the whole batch. Must stay consistent with
# AI_ANALYSIS_PROCESSING_TIMEOUT_MS below — see its comment.
AI_ANALYSIS_MAX_BATCH_SIZE=25
# How long a claim is held. MUST exceed the batch's worst case, which the config
# validator enforces at boot:
#   ceil(MAX_BATCH_SIZE / AI_LLM_MEDIA_MAX_CONCURRENT) vision waves
#     x AI_LLM_VISION_ANALYSIS_TIMEOUT_MS + AI_ANALYSIS_LLM_TIMEOUT_MS
# With the shipped defaults: ceil(25/4)=7 x 120s + 90s = 930s, so 1500000 leaves
# headroom. A shorter lease means a slow batch is reclaimed and reprocessed by
# a second worker while the first is still paying for it.
AI_ANALYSIS_PROCESSING_TIMEOUT_MS=1500000
AI_LLM_MEDIA_MAX_CONCURRENT=4           # Vision pre-pass fan-out; also the wave divisor above (default: 4)
AI_LLM_VISION_ANALYSIS_TIMEOUT_MS=120000 # Per-call vision deadline (default: 120000)
AI_ANALYSIS_LLM_TIMEOUT_MS=90000        # Per-call moderation deadline (default: 90000)
AI_ANALYSIS_POLL_INTERVAL_MS=2000       # Poll interval when the queue is empty (default: 2000)
AI_ANALYSIS_MAX_ATTEMPTS=5              # Attempts before a message is parked as `dead` (default: 5)
AI_ANALYSIS_RETRY_BACKOFF_MS=15000      # Backoff base; attempt N waits base x 2^(N-1) (default: 15000)
AI_LLM_MAX_COMPLETION_TOKENS=16384      # Completion ceiling. A large batch is a long JSON object
                                        # and truncating it mid-array is what makes a batch unparseable.

# === Auto-Delete ===
# Always on. A message the model judges a violation is removed; there is no
# dry-run and no disable — a deletion nobody can audit is not worth automating,
# so `reason` on the verdict row records why.
AUTO_DELETE_FLAGGED_DELAY_MS=0          # Grace period between verdict and deletion (default: 0)
AUTO_DELETE_MIN_CONFIDENCE=0.5          # Minimum AI confidence threshold 0-1 (default: 0.5)
AUTO_DELETE_ALLOWED_CATEGORIES=          # Comma-separated category filter (empty = all)
AUTO_DELETE_EXCLUDED_CHANNEL_IDS=        # Comma-separated channel IDs to exclude
AUTO_DELETE_EXCLUDED_USER_IDS=           # Comma-separated user IDs to exclude
AUTO_DELETE_LOG_CHANNEL_ID=              # Channel ID to log auto-delete actions
AUTO_NICKNAME_RESET_COOLDOWN_MS=600000  # Per-member cooldown between nickname resets (default: 10m)

# === Retention (0 = disabled) ===
RETENTION_MESSAGES_DAYS=0               # Message retention in days (default: 0 = off)
RETENTION_ATTACHMENTS_DAYS=0            # Attachment retention in days (default: 0 = off)
RETENTION_CLEANUP_INTERVAL_MS=86400000  # Cleanup interval in ms (default: 24h)
