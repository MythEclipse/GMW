></mxCell><mxCell id="e13" value="discord:message:analyzed" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;endArrow=blockThin;fontColor=#b85450;" edge="1" parent="1" source="mwwrite" target="bever"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="recommended_action = delete" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;endArrow=blockThin;" edge="1" parent="1" source="bever" target="beact"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="bot deletes / DMs" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;endArrow=blockThin;" edge="1" parent="1" source="bebot" target="beact"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="list guilds/channels" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=blockThin;dashed=1;" edge="1" parent="1" source="gwcmd" target="gwc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="lease expiry → auto-return to pending" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;endArrow=blockThin;dashed=1;fontColor=#b8860b;" edge="1" parent="1" source="mwclaim" target="pgmsg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="gone" value="REMOVED in the rewrite" style="swimlane;html=1;horizontal=1;startSize=32;rounded=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1450" height="250" as="geometry"/></mxCell><mxCell id="g1" value="Piscina worker pools (ai-analysis-worker.ts, circuitBreaker.ts)
→ one pg Pool per worker thread; text+media starvation bug" style="ORANGE;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="gone"><mxGeometry x="20" y="45" width="330" height="70" as="geometry"/></mxCell><mxCell id="g2" value="All in-memory coordination (conversationState.ts, batchScheduler.ts,
individualFallbackProcessor.ts, moderationState.ts, recovery-worker.ts)
→ ~1,630 LOC of timers + lane locks + cooldowns + setter injection" style="ORANGE;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="gone"><mxGeometry x="370" y="45" width="380" height="70" as="geometry"/></mxCell><mxCell id="g3" value="budget-overflow un-claim (batchBudget.ts) + stuck sweeper
→ the two workarounds for the lane-claim bug" style="ORANGE;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="gone"><mxGeometry x="770" y="45" width="330" height="70" as="geometry"/></mxCell><mxCell id="g4" value="31 AI_* config knobs → ~8 (one lane budget, one lease TTL,
attempts cap, backoff base, LLM timeouts, models, master toggle)" style="ORANGE;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="gone"><mxGeometry x="1120" y="45" width="310" height="70" as="geometry"/></mxCell><mxCell id="g5" value="Circular + dynamic imports (batchProcessor→batchScheduler, aiAnalyzer→learners)
→ 23 `as unknown as` type leaks at boundaries" style="ORANGE;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="gone"><mxGeometry x="20" y="130" width="680" height="50" as="geometry"/></mxCell><mxCell id="g6" value="Global individual-fallback circuit breaker (one slow LLM call silenced every conversation)
→ per-conversation, durable" style="ORANGE;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="gone"><mxGeometry x="720" y="130" width="710" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2-Durable-State-Machine" name="2-Durable-State-Machine"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="The fix: one durable state machine in Postgres, zero in-memory coordination" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1100" height="40" as="geometry"/></mxCell><mxCell id="s0" value="CAPTURED
(gateway INSERT)" style="fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="190" height="65" as="geometry"/></mxCell><mxCell id="s1" value="PENDING
ready_for_work_at &lt;= now()" style="fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="200" height="65" as="geometry"/></mxCell><mxCell id="s2" value="CLAIMED
lease_until = now()+TTL
attempts += 1" style="fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="660" y="120" width="210" height="65" as="geometry"/></mxCell><mxCell id="s3" value="ANALYZED
verdict written" style="fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="870" y="120" width="180" height="65" as="geometry"/></mxCell><mxCell id="s4" value="RETRY_WAIT
ready_for_work_at = now()+backoff" style="fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="590" y="290" width="210" height="65" as="geometry"/></mxCell><mxCell id="s5" value="DEAD
attempts &gt;= max
visible in dashboard" style="fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="870" y="290" width="180" height="65" as="geometry"/></mxCell><mxCell id="a1" value="insert" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=blockThin;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="FOR UPDATE SKIP LOCKED" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;endArrow=blockThin;fontColor=#b8860b;labelBackgroundColor=#ffffff;verticalAlign=top;spacingTop=6;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" value="verdict ok" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;endArrow=blockThin;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=4;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" value="LLM/parse error" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;endArrow=blockThin;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=4;" edge="1" parent="1" source="s2" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a5" value="backoff elapsed" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;endArrow=blockThin;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=4;" edge="1" parent="1" source="s4" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a6" value="attempts &gt;= max" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;endArrow=blockThin;labelBackgroundColor=#ffffff;verticalAlign=top;spacingTop=4;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a7" value="LEASE EXPIRED
(worker crashed) → reclaim
no sweeper, no 120s wait" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;endArrow=blockThin;dashed=1;fontColor=#b85450;" edge="1" parent="1" source="s2" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="695" y="250"/></Array></mxGeometry></mxCell><mxCell id="n1" value="Why this removes the &#x27;stuck message&#x27; class of bugs entirely:" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="900" height="30" as="geometry"/></mxCell><mxCell id="n_440" value="Every state transition is a single UPDATE. There is no second copy of the truth in RAM to drift." style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="440" width="1000" height="22" as="geometry"/></mxCell><mxCell id="n_466" value="A crash cannot leak a lock — a lease is a timestamp, and an expired lease is simply re-claimable." style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="466" width="1000" height="22" as="geometry"/></mxCell><mxCell id="n_492" value="Restart loses nothing. Today every restart drops in-flight work into a hole that only the sweeper can find." style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="492" width="1000" height="22" as="geometry"/></mxCell><mxCell id="n_518" value="Two workers can never double-process: SKIP LOCKED is the DB&#x27;s atomic claim, not an in-memory flag." style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="518" width="1000" height="22" as="geometry"/></mxCell><mxCell id="n_544" value="&#x27;Pending&#x27; is a query, not a schedule. No debounce timer, no lane lock, no re-arm-after-success." style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="544" width="1000" height="22" as="geometry"/></mxCell><mxCell id="n_570" value="Backoff is per-message and stored. A circuit breaker that silences one conversation cannot silence another." style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="570" width="1000" height="22" as="geometry"/></mxCell><mxCell id="n_596" value="DEAD is a real terminal state you can see and requeue — today &#x27;gave up&#x27; is indistinguishable from &#x27;in flight&#x27;." style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="596" width="1000" height="22" as="geometry"/></mxCell><mxCell id="n2" value="The claim query (the only scheduling primitive the new system needs):" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="900" height="30" as="geometry"/></mxCell><mxCell id="code1" value="-- workers poll this; no timer, no in-memory debounce
UPDATE messages SET
    status        = &#x27;claimed&#x27;,
    lease_until   = now() + interval &#x27;90 seconds&#x27;,
    attempts      = attempts + 1,
    worker_id     = $1
WHERE id IN (
  SELECT id FROM messages
  WHERE status = &#x27;pending&#x27;
    AND ready_for_work_at &lt;= now()
    AND deleted_at IS NULL
  ORDER BY created_at
  FOR UPDATE SKIP LOCKED
  LIMIT 40
)
RETURNING *;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#1e1e1e;strokeColor=#b85450;fontColor=#e8e8e8;fontSize=11;fontFamily=Courier New;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="620" height="230" as="geometry"/></mxCell><mxCell id="code2" value="Claiming is per-ROW, not per-conversation.

The old bug: claim every pending row in a
conversation → filter to one lane → the other
lane&#x27;s rows stay stuck in &#x27;processing&#x27; for
120 s until the sweeper notices.

New: the media filter is a WHERE clause on
the claim itself, so a row is never claimed
by a worker that cannot process it." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#3d2c00;fontSize=11;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="680" width="480" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3-Stuck-Message-Root-Cause" name="3-Stuck-Message-Root-Cause"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t3" value="Root cause: why messages get stuck today (a conversation with 3 text + 2 media messages)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1200" height="40" as="geometry"/></mxCell><mxCell id="b1" value="5 messages pending in one conversation" style="fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="250" height="50" as="geometry"/></mxCell><mxCell id="b2" value="text lane timer fires
(messagesAnalysis.ts:215)" style="fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="250" height="55" as="geometry"/></mxCell><mxCell id="b3" value="getPendingMessagesByConversation()
claims ALL 5 → status=&#x27;processing&#x27;
(FOR UPDATE SKIP LOCKED — correct)" style="fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="265" width="250" height="70" as="geometry"/></mxCell><mxCell id="b4" value="scheduler filters to THIS lane
splitMessagesByLane() → 3 text
(batchScheduler.ts:122)" style="fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="250" height="65" as="geometry"/></mxCell><mxCell id="b5" value="✗ the 2 media rows are DROPPED
but remain &#x27;processing&#x27; in the DB.
computeBudgetOverflowMessages() only
