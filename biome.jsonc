{
  // Root Biome config — strict where safe, not breaking existing codebase unnecessarily
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "tests-gateway/**/*.ts",
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "*.ts",
      "*.mjs",
      "scripts/**/*.ts",
      "scripts/**/*.mjs",
      "!vendor",
      "!.claude",
      "!apps/**/dist",
      "!apps/**/.next",
      "!apps/**/out",
      "!apps/frontend/src/routeTree.gen.ts",
      "!apps/frontend/src/styles.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "warn",
        "useNodejsImportProtocol": "warn",
        "useImportType": "warn",
        "useConst": "warn"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "useIterableCallbackReturn": "off",
        "noArrayIndexKey": "off",
        "noExplicitAny": "off",
        "noAssignInExpressions": "off"
      },
      "a11y": {
        "useSemanticElements": "off",
        "useButtonType": "off",
        "noAutofocus": "off",
        "useMediaCaption": "off",
        "noStaticElementInteractions": "off",
        "useFocusableInteractive": "off",
        "useKeyWithClickEvents": "off",
        "noLabelWithoutControl": "off"
      },
      "performance": {
        "noImgElement": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "correctness": {
        "noInvalidUseBeforeDeclaration": "off",
        "useExhaustiveDependencies": "off",
        "noUnusedFunctionParameters": "warn",
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noUnusedPrivateClassMembers": "warn"
      },
      "complexity": {
        "useSimplifiedLogicExpression": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["apps/frontend/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "noLabelWithoutControl": "off"
          },
          "suspicious": {
            "noDocumentCookie": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "warn"
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.mjs", "apps/backend/scripts/**/*.mjs", "apps/backend/tests-gateway/**/*.mjs", "apps/backend/tests/**/*.mjs"],
      "linter": {
        "rules": {
          "style": { "useNodejsImportProtocol": "off" }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "double",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  }
}
