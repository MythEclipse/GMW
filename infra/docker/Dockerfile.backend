# ---- Builder stage ----
# An ARG before the first FROM is in scope only for that FROM instruction. Every
# later stage that wants to name the same base must redeclare it, or the build
# fails with `base name (${NODE_IMAGE}) should not be blank`.
ARG NODE_IMAGE=node:22-slim
FROM ${NODE_IMAGE} AS builder

WORKDIR /build

# pnpm pinned to the repo's declared packageManager version rather than a
# floating `pnpm@10`, so an unchanged commit cannot produce a different image.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COREPACK_ENABLE_STRICT=1 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

# Build tools for native addons (discordjs/voice may need node-gyp)
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy source + manifests
# The root package.json and pnpm-workspace.yaml are still needed: pnpm resolves
# the workspace before it can install this app's dependencies.
#
# `packages/` is deliberately NOT copied. It held `packages/db`, which existed
# only to vendor the Prisma client and was unreferenced after the ORM moved to
# Drizzle. The comment claiming "the backend imports @gmw/db from packages/db"
# was left over from that era and was untrue; the COPY would fail outright once
# the directory was deleted.
COPY package.json ./
COPY pnpm-workspace.yaml ./
# tsconfig.base.json is REQUIRED: apps/backend/tsconfig.json extends
# "../../tsconfig.base.json", and tsc fails with
# "TS5083: Cannot read file '/build/tsconfig.base.json'" without it. The frontend
# tsconfig likewise extends it, so the proxy build needs it too.
COPY tsconfig.base.json ./
# The lockfile MUST be in the context. Without it `--frozen-lockfile` fails with
# ERR_PNPM_NO_LOCKFILE, which is why this file previously said
# `--no-frozen-lockfile` — and that bypass is what let `@types/bun: latest`
# resolve to a version whose globals break the Node typecheck. The lockfile is
# the fix for both, not a file to leave out.
COPY pnpm-lock.yaml ./
COPY apps/backend/ ./apps/backend/

WORKDIR /build/apps/backend

# Install ALL deps (devDeps needed for TypeScript build)
#
# --frozen-lockfile, deliberately. The previous `--no-frozen-lockfile` here is
# what made this image unbuildable: `"@types/bun": "latest"` in
# apps/backend/package.json resolves afresh on every build, and 1.4.3 (released
# after the lockfile was written, which pins 1.4.2) injects Bun globals that make
# the Node `tsc` typecheck fail inside node_modules' own .d.ts files — errors in
# drizzle-orm and hono that have nothing to do with this repository's code. The
# build passed locally against the lockfile, so the lockfile is the correct
# input here, not a nuisance to bypass.
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Build TypeScript
RUN ./node_modules/.bin/tsc

# Production dependencies, resolved in their own stage from a clean tree.
#
# This is a separate stage rather than a second `pnpm install --prod` over the
# build tree, because switching an existing modules directory from dev to prod
# makes pnpm want to purge it, and it refuses to do that without a TTY:
#
#   ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY
#
# That error names neither the TTY nor the install that provoked it, and the
# workaround people reach for is `--config.confirmModulesPurge=false`. A clean
# stage avoids the question entirely, is easier to read, and still uses the
# shared pnpm store mount so nothing is downloaded twice.
# An ARG declared before the first FROM is only in scope FOR that FROM
# instruction — it is not automatically available to later FROMs, which fail with
# `base name (${NODE_IMAGE}) should not be blank`. Redeclared with no default so
# it picks up the value from the first declaration.
ARG NODE_IMAGE=node:22-slim
FROM ${NODE_IMAGE} AS prod-deps
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COREPACK_ENABLE_STRICT=1 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH
WORKDIR /build
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

COPY package.json pnpm-workspace.yaml tsconfig.base.json pnpm-lock.yaml ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/frontend/package.json apps/frontend/package.json
# `node-linker=hoisted` produces a plain, self-contained node_modules of real
# directories instead of symlinks.
#
# pnpm's default linker fills node_modules with symlinks whose targets live at a
# path fixed at install time:
#
#   /build/apps/backend/node_modules/pino -> ../../../node_modules/.pnpm/pino@…/…
#
# The runtime stage then copies one of those trees without the other, the link
# dangles, and the app dies on its first import with
# `ERR_MODULE_NOT_FOUND: Cannot find package 'pino'` — a message that names
# neither the symlink nor the missing store, and blames a package that is present
# in the manifest AND visible in the image.
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --prod --frozen-lockfile --config.node-linker=hoisted \
    && pnpm store prune

# ---- Runtime stage ----
FROM node:22-alpine

WORKDIR /app

COPY --from=builder --chown=node:node /build/apps/backend/dist ./dist
COPY --from=prod-deps --chown=node:node /build/node_modules ./node_modules
COPY --from=prod-deps --chown=node:node /build/apps/backend/package.json ./

USER node
EXPOSE 4001

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4001/api/health',r=>process.exit(r.statusCode===200?0:1))"

CMD ["node", "dist/index.js"]
