# ---- Builder stage: Next.js static export ----
FROM node:22-slim AS builder

WORKDIR /build

# pnpm is pinned to the version the repo declares, not to a floating `pnpm@10`.
# The repo's packageManager field is `pnpm@10.33.2`; a floating tag means an image
# built from an unchanged commit can differ, and a major/minor bump lands in the
# next image without a diff to review. `COREPACK_ENABLE_DOWNLOAD_PROMPT=0` keeps
# corepack non-interactive on a runner with no TTY.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COREPACK_ENABLE_STRICT=1 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

# Build essentials. The only native dep this image installs is the Discord
# stack's optional `bufferutil` / `utf-8-validate`; the backend's `sharp` is
# gone with the image-resize module that used it.
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    make g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy source + manifests, preserving the monorepo LAYOUT.
#
# The layout is load-bearing, not cosmetic:
#   - apps/frontend/tsconfig.json extends "../../tsconfig.base.json", so the file
#     must sit two levels above it or tsc fails with
#     `TS5083: Cannot read file`.
#   - its `#/*` path alias maps to `../backend/src/*`, so the backend's sources
#     are part of resolving the frontend's types.
#
# Copying `apps/frontend/` to the build ROOT flattened that structure, which is
# why both errors appeared at once.
COPY tsconfig.base.json pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/frontend/ ./apps/frontend/
COPY apps/backend/ ./apps/backend/

# Install ALL workspace deps, not just the frontend's.
#
# The frontend's `#/*` alias maps into `../backend/src/*`, so the typecheck reads
# real backend SOURCES — and those import @orpc/server, zod and axios. Installing
# only apps/frontend leaves every one of them unresolvable:
#   ../backend/src/api-types.ts(20,35): error TS2307: Cannot find module '@orpc/server'
#
# The `--filter` variant looks like an optimisation and is the direct cause of
# that. The whole workspace is 2 apps and installs in seconds.
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Build static export
RUN pnpm --filter ./apps/frontend run build

# ---- Runtime stage: nginx ----
FROM nginx:alpine

COPY infra/docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf
# `dist`, not `out`. apps/frontend is a Vite SPA (vite.config.ts sets
# build.outDir = "dist"); the previous path was Next's static-export directory and
# only matched because the app used to be Next. Vite resolves outDir relative to
# the project root, so with the workspace layout preserved it lands here.
COPY --from=builder /build/apps/frontend/dist/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
