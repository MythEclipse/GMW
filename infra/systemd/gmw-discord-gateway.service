[Unit]
Description=GMW Discord Gateway — message capture, voice, AI moderation
After=network-online.target
Requires=network-online.target

[Service]
Type=simple

# Secrets dari Bitwarden Secrets Manager (BWS): wrapper fetch env lalu exec binary
ExecStart=/usr/local/bin/bws-exec gmw /opt/gmw/bin/gmw-discord-gateway

Restart=always
RestartSec=5

User=gmw
Group=gmw

Environment=PATH=/run/wrappers/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
