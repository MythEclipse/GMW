[Unit]
Description=GMW Discord Gateway — moderation worker (separate process)
After=network-online.target gmw-discord-gateway.service
Requires=network-online.target

[Service]
Type=simple

# Secrets dari Bitwarden Secrets Manager (BWS): wrapper fetch env lalu exec binary
ExecStart=/usr/local/bin/bws-exec gmw /opt/gmw/bin/gmw-discord-gateway-worker

Restart=always
RestartSec=5

User=gmw
Group=gmw

Environment=PATH=/run/wrappers/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

# The worker polls Postgres; it holds no queue in memory, so it needs far
# less than the gateway's 1G.
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
